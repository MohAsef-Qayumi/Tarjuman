# Providers are tried in this order; one with a missing key or model is skipped.
TRANSLATE_PROVIDERS=gemini,groq,openrouter

# Free keys: https://aistudio.google.com/apikey · https://console.groq.com/keys · https://openrouter.ai/keys
# Pick a current model from each provider's model list.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Requests per minute allowed from one IP address.
RATE_LIMIT_PER_MINUTE=20

# Set to 1 to return canned translations without calling any provider (local development, tests).
TARJUMAN_MOCK=
